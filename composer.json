{
    "name": "phichaphop/blue",
    "description": "Blue OS — Resource Operating System (modular monolith, PHP 8 + MySQL/MariaDB)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Blue\\Core\\": "core/",
            "Blue\\Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blue\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "test": "phpunit",
        "check": "php bin/blue check:all"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
